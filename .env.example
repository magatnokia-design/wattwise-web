# Copy to .env and fill in. .env is gitignored; this file is not.

# reCAPTCHA v3 SITE key for Firebase App Check.
#
# This is the public half of the pair. Vite inlines any VITE_* variable into the
# bundle at build time, so it ships to every visitor either way - it is not a
# secret and is not treated as one. It lives here rather than in the source only
# so the value can differ between a local build and a deployed one.
#
# The matching SECRET key is a different value entirely. It goes into the
# Firebase console (App Check -> the web app -> reCAPTCHA v3) and must never
# appear in this repository, in a bundle, or in a chat window.
#
# Leaving this unset is supported: config.js skips App Check entirely rather
# than failing, so a build without a key works normally.
VITE_APPCHECK_RECAPTCHA_KEY=
